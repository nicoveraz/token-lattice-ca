% ===== Most-threatening prior work (rank order from the novelty check) =====
% #1 shared dynamical substrate (Glauber resampling on token lattice); uses MAXIMAL
% coupling, provably distinct from our common-random-number coupling. Measures mixing
% time / metastability, NOT damage spreading / velocity / damping length / Lyapunov.
@misc{glauber_mlm,
  title={Mixing Times of Glauber Dynamics on Masked Language Models},
  author={Levine, Yotam and others},
  year={2026}, note={arXiv:2605.16378 (verify authors)},
  eprint={2605.16378}, archivePrefix={arXiv}}

% #2 biggest threat to the capacity->sensitivity/edge-of-chaos claim: Lyapunov exponents
% of trained self-attention Jacobians; max-Lyapunov ~ 0 (edge of chaos) <-> high accuracy.
% Continuous hidden space, correlates with performance (not model-size -> sensitivity).
@misc{lyap_selfattn,
  title={Recurrent Self-Attention Dynamics and Criticality of Trained Transformers},
  author={Tomihari, Akiyoshi and Karakida, Ryo},
  year={2025}, note={NeurIPS 2025; arXiv:2505.19458 (verify title)},
  eprint={2505.19458}, archivePrefix={arXiv}}

% #3 SPARC: error-propagation operator = product of per-step attention Jacobians;
% self-correction blind spot iff spectral radius rho(F_T) >= 1 (= top Lyapunov boundary).
% Activation space, deterministic-linear, AR LLMs. NOTE: 2607.09803 = SPARC, not QUIVER.
@misc{sparc,
  title={SPARC: Spectral Origins of the Self-Correction Blind Spot in Autoregressive Generation},
  author={Petrova and Vejsiu},
  year={2026}, note={arXiv:2607.09803},
  eprint={2607.09803}, archivePrefix={arXiv}}

