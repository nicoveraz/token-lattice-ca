  "spearman_tstar_rep4": {
   "rho": 0.575,
   "p": 0.0277,
   "n": 15,
   "censored": 1
  },
  "spearman_family_level": {
   "rho": 0.483,
   "p": 0.1893,
   "n_families": 9
  },
  "group_difference": {
   "concentrate": 0.509,
   "never": 0.572,
   "p": 0.4055
  }
