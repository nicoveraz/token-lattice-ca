# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
.venv/
venv/

# OS
.DS_Store

# HuggingFace / torch caches (Phase 3) — keep out of the repo
hf_cache/
*.pt

# Scratch
scratch/
*.tmp

# Note: ckpt/ (0.42M-param checkpoints), data/, results/, and fig/ ARE tracked
# on purpose — the pilot must be reproducible without retraining.

# LaTeX build artifacts (paper.pdf IS committed; intermediates are not)
paper_arxiv/*.aux
paper_arxiv/*.bbl
paper_arxiv/*.blg
paper_arxiv/*.log
paper_arxiv/*.out
paper_arxiv/*.xdv
paper_arxiv/*.fdb_latexmk
paper_arxiv/*.fls

# personal planning doc: contains the author's username and absolute paths (double-blind)
paper_arxiv/plan_to_submission_i4d.md

# tectonic intermediates
paper_arxiv/*.xdv
paper_arxiv/*.bbl
paper_arxiv/*.blg
paper_arxiv/*.pdf
paper_arxiv/*.aux
paper_arxiv/*.log
paper_arxiv/*.out

# Claude Code local settings (workflows are tracked deliberately)
.claude/settings.local.json
.claude/scheduled_tasks*

# arXiv submission tarballs (rebuild with the matching make_arxiv_package.sh). Build artefacts:
# they are reproducible from the tracked source and verified at build time, so tracking them would
# only create a second copy of the paper that can silently disagree with main.tex.
paper_arxiv/arxiv-submission.tar.gz
paper2_arxiv/arxiv-submission.tar.gz

# analogy audit -- restored locally, deliberately untracked for now
quantum_reading.md

# API keys -- never commit
.env
*.key
secrets.json

# Next-paper planning -- deliberately local, must never reach the public repo
future_work.md
failure_registry.md
# paper_corrections.md: weighs a correction to a PUBLISHED paper. It is a decision record, not a
# result, and it names a defect in an artifact that is already public -- so it stays local until
# the author has decided what to do, at which point the decision (not this file) goes out.
paper_corrections.md

# review/: the private audit render -- one folder per stored result, rebuilt on demand
# by experiments/build_review.py. Derived from results/ and findings.md, so it carries no
# information they do not, and it is large (a chart per experiment).
review/

# paper2 build artefacts -- main.tex and refs.bib are the sources; the PDF is rebuilt by
# `cd paper2_arxiv && tectonic main.tex`
paper2_arxiv/main.pdf
paper2_arxiv/main.log
paper2_arxiv/main.blg
paper2_arxiv/main.aux
paper2_arxiv/main.bbl
paper2_arxiv/main.out

# Paper 3 build artefacts. Rebuild with `cd paper3_arxiv && tectonic main.tex`. Tracked by mistake
# until 22 Aug 2026 -- a wholesale `git add paper3_arxiv/` caught them, so every rebuild dirtied the
# tree and the repository carried a second copy of the paper that could silently disagree with
# main.tex. Same policy as papers 1 and 2.
paper3_arxiv/main.pdf
paper3_arxiv/main.log
paper3_arxiv/main.blg
paper3_arxiv/main.aux
paper3_arxiv/main.bbl
paper3_arxiv/main.out
paper3_arxiv/arxiv-submission.tar.gz
